# LeadMind MCP — environment configuration
# Copy to `.env` and fill in your values.

# --- Groq API (free tier) ---
# Get a free key at https://console.groq.com/keys
# If empty, the server runs in fallback-only mode (still fully functional).
GROQ_API_KEY=

# --- Authentication (optional, for SSE / webhook deployments) ---
# Set LEADMIND_AUTH_ENABLED=true to require an API key on the webhook + SSE endpoints.
LEADMIND_API_KEY=demo-key-please-change
LEADMIND_AUTH_ENABLED=false

# --- Demo mode ---
# When true, the database is reset to seed data every DEMO_RESET_INTERVAL_SEC
# so the public GitHub demo always shows a populated, uncorrupted pipeline.
DEMO_MODE=true
DEMO_RESET_INTERVAL_SEC=21600

# --- Cache ---
CACHE_TTL_SEC=300
CACHE_MAX_ENTRIES=500

# --- MCP transport ---
# "stdio" (default, for Claude Desktop) or "sse" (for remote clients)
MCP_TRANSPORT=stdio
MCP_PORT=8080

# --- Optional integrations ---
# Outbound n8n webhook (leave empty to disable)
N8N_WEBHOOK_URL=
# Gmail notification target (leave empty to disable; see README for setup)
GMAIL_NOTIFY_TO=

# --- Database path (optional override) ---
# LEADMIND_DB_PATH=/path/to/leadmind.db
